<?xml version="1.0"?>
<!DOCTYPE Xdmf SYSTEM "Xdmf.dtd" []>
<Xdmf Version="3.0" xmlns:xi="https://www.w3.org/2001/XInclude">
  <Domain>
    <Grid Name="mesh" GridType="Uniform">
      <Topology TopologyType="Tetrahedron" NumberOfElements="76800" NodesPerElement="4">
        <DataItem Dimensions="76800 4" NumberType="Int" Format="HDF">chip_temperature.h5:/Mesh/mesh/topology</DataItem>
      </Topology>
      <Geometry GeometryType="XYZ">
        <DataItem Dimensions="15129 3" Format="HDF">chip_temperature.h5:/Mesh/mesh/geometry</DataItem>
      </Geometry>
    </Grid>
    <Grid Name="temperature_rise" GridType="Collection" CollectionType="Temporal">
      <Grid Name="temperature_rise" GridType="Uniform">
        <xi:include xpointer="xpointer(/Xdmf/Domain/Grid[@GridType='Uniform'][1]/*[self::Topology or self::Geometry])" />
        <Time Value="0" />
        <Attribute Name="temperature_rise" AttributeType="Scalar" Center="Node">
          <DataItem Dimensions="15129 1" Format="HDF">chip_temperature.h5:/Function/temperature_rise/0</DataItem>
        </Attribute>
      </Grid>
    </Grid>
  </Domain>
</Xdmf>
